@layout EmptyLayout
@page "/es/TablaPendientes"
@page "/es/TablaPendientes/{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}/{idrespo:int}"
@page "/en/TablePending"
@page "/en/TablePending/{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}/{idrespo:int}"

@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject IMaestraData MaestraData
@inject ICausaCalidadData CausaCalidadData
@inject IDiccionarioTraduccionesService DiccionarioTraduccionesService
@inject LocalizationService LocalizationService
@inject ITranslationService Translator

@using ReunionWeb.Resources
@using System.Globalization
@using ReunionWeb.Services

@if (!traduccionesCargadas || dataIsLoaded == 1)
{
    <div class="loading-container">
        <div class="loader"></div>
    </div>
}
else
{
<BSRow>
    <BSCol ColumnSmall="1" Column="2">
        <BSLabel>@DiccionarioTraduccionesService.Traducciones["Codigo"]</BSLabel>
                <BSInput InputType="InputType.Select" IsDisabled @bind-Value="Codigo">
                    <option value="Todo">@DiccionarioTraduccionesService.Traducciones["EnCurso"]</option>
                    <option value="6">@DiccionarioTraduccionesService.Traducciones["EnCurso"]</option>
                </BSInput>
    </BSCol>

    <BSCol ColumnSmall="1" Column="2">
        <BSLabel>@DiccionarioTraduccionesService.Traducciones["Estado"]</BSLabel>
        <BSInput InputType="InputType.Select" @bind-Value="Status">
            <option value="Todo">@DiccionarioTraduccionesService.Traducciones["Todo"]</option>
            <option value="Pendiente">@DiccionarioTraduccionesService.Traducciones["Pendiente"]</option>
            <option value="Cerrado">@DiccionarioTraduccionesService.Traducciones["Cerrado"]</option>
        </BSInput>
    </BSCol>

    <BSCol Column="3">
        <BSLabel>@DiccionarioTraduccionesService.Traducciones["Responsable"]</BSLabel>
        <BSInput InputType="InputType.Select" @bind-Value="idrespo">
            <option value=0>@DiccionarioTraduccionesService.Traducciones["Todo"]</option>
            @foreach (var d in RespoReuData.resporeus.Where(x => AllowedResponsables.Contains(x.IdResReu)))
            {
                var texto = idPais == 5? d.Rrenglish : d.Rrnombre;
                <option value="@d.IdResReu">@texto</option>
            }
        </BSInput>
    </BSCol>
    @{
        var lineaTraducida = idPais == 5 ? "All" : "Todos";
    }
    <BSCol Column="3">
        <BSLabel>@DiccionarioTraduccionesService.Traducciones["Linea"]</BSLabel>
        <BSInput InputType="InputType.Text" Value="@lineaTraducida" IsReadonly="true" />
    </BSCol>


</BSRow>
<button type="button" onclick="window.print()" class="btn btn-success"><span class="oi oi-print"></span></button>
<p></p>

<body>
    @if (PizarraData.reudiatablas.Any() && dataIsLoaded == 2)
    {


        <BSTable IsStriped="true" IsBordered="true">
            <BSTHead Class="cabecera">
                <BSTR>

                    @*<BSTD>Id</BSTD>*@
                    @*Centro para validar el comedor*@

                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Area"]</BSTD>
                    <BSTD>Ksf</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]</BSTD>
                    <BSTD ColSpan="4">@DiccionarioTraduccionesService.Traducciones["Discrepancia"]</BSTD>
                    @* <BSTD>Código</BSTD> *@
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["PlanDeAccion"]</BSTD>
                    @* <BSTD>Tiempo</BSTD> *@
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Responsable"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["DetallesDeCalidad"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["OrgDelProducto"]</BSTD>
                    <BSTD>Status</BSTD>
                    @* <BSTD>ODT</BSTD> *@
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDeReunion"]</BSTD> @*Fecha del dia de reunion*@
                    @* <BSTD>Fecha del Trabajo</BSTD>Fecha de listo el trabajo *@


                </BSTR>
            </BSTHead>
            <BSTBody>
                @* @if (UsrRol == "Calidad" | UsrRol == "Seguridad" | UsrRol.Substring(0,4).ToString()=="Mtto")
            @if (UsrRol == "Calidad" | UsrRol == "Seguridad" | UsrRol=="Mtto")*@
                @if (UsrRol != "")
                {
                    listareu = PizarraData.reudiatablas.Where(r => !string.IsNullOrEmpty(r.Responsable) && r.Responsable.StartsWith(UsrRol)).ToList();
                }
                else
                {
                    listareu = PizarraData.reudiatablas;

                }
                @* @foreach (var d in DbReunionService.reudiatablas)*@
                @foreach (var d in listareu)
                {
                    @if (linea == "Todo" || linea == d.Rdarea)
                    {
                        @if (Codigo == d.RdcodDis || Codigo == "Todo")
                        {
                            @if (Status == d.Rdstatus || Status == "Todo" || Status == "Total Pendiente" && (d.Rdstatus == "Pendiente" ||
                           d.Rdstatus == "Pendiente/Responsable"))
                            {
                                @if (idrespo == 0 || idrespo == d.IdResReu)
                                {
                                    <BSTR>
                                        @*<BSTD>@d.IdReuDia</BSTD>*@

                                        <BSTD>@d.Rdarea</BSTD>
                                        <BSTD>
                                            @{
                                                var texto = idPais == 5 
                                                ? KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfEnglish 
                                                : KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfNombre;
                                            }                                          
                                            @(
                                                texto ?? string.Empty
                                            )
                                        </BSTD>
                                        <BSTD>@d.RdcodEq</BSTD>
                                        <BSTD ColSpan="4">@(d.Rddisc?.ToUpperInvariant() ?? string.Empty)</BSTD>
                                        @* <BSTD>@d.RdcodDis</BSTD> *@
                                        <BSTD Class="textotabla">@d.RdplanAcc</BSTD>
                                        @* <BSTD>@d.Rdtiempo</BSTD> *@
@{
                                            var responsable = RespoReuData.resporeus.FirstOrDefault(x => x.IdResReu == d.IdResReu);
                                            var nombreResponsable = idPais == 5 
                                                ? responsable?.Rrenglish 
                                                : responsable?.Rrnombre ?? string.Empty;
                                        }
                                        <BSTD class="@(nombreResponsable == "Por Definir" ? "Definir" : "")">@nombreResponsable</BSTD>
                                        <BSTD>
                                        @{
                                            var causa = CausaCalidadData.causaCals.FirstOrDefault(x => x.IdCausaCal == d.IdCausaCal);
                                            var texto = idPais == 5 ? causa?.Ccenglish : causa?.Ccnombre;
                                        }
                                        @texto
                                        </BSTD>
                                        <BSTD>@d.OrigenCal.ToUpperInvariant()</BSTD>
                                        @{
                                            var estadoTraducido = d.Rdstatus == "Cerrado"
                                                ? (idPais == 5 ? "Closed" : "Cerrado")
                                                : (idPais == 5 ? "Pending" : "Pendiente");

                                            var claseEstado = d.Rdstatus == "Cerrado" ? "Cerrado" : "pendiente";
                                        }

                                        <BSTD Class="@claseEstado">@estadoTraducido</BSTD>
                                        @* <BSTD>@d.Rdodt</BSTD> *@
                                        <BSTD>@d.RdfecReu.ToString("dd/MM/yyyy")</BSTD>
                                        @* <BSTD>@d.RdfecTra.ToString("dd/MM/yyyy")</BSTD> *@

                                    </BSTR>

                                }
                            }
                        }
                    }



                }


            </BSTBody>

        </BSTable>
    }
</body>
}
@code {
    [Parameter]
    public string? accion { get; set; }//centro
    [Parameter]
    public string? division { get; set; }//division
    [Parameter]
    public string? f1 { get; set; }
    [Parameter]
    public string? linea { get; set; }
    [Parameter]
    public string? f2 { get; set; }
    [Parameter]
    public string? tipo { get; set; }
    [Parameter]
    public string? est { get; set; }
    [Parameter]
    public int? idrespo { get; set; }//responsable a filtar

    private int idPais { get; set; }

    int dataIsLoaded = 0;
    //int CentroComedor = 0;

    private string Codigo { get; set; } = "Todo"; //Codigo
    private string Status { get; set; } = "Todo"; //Status
    private string UsrAdmin { get; set; } = ""; //permisos de admin
    private string UsrRol { get; set; } = ""; //rol para filtrar

    private List<AsistenReuDTO> listaAsistencia { get; set; } = new ();
    private List<LineaDTO> lineas { get; set; } = new ();
    private List<DivisionDTO> divisions { get; set; } = new ();
    private List<MaestraVDTO> centro { get; set; } = new ();
    private List<KsfDTO> ksfs { get; set; } = new ();
    private List<RespoReuDTO> resporeu { get; set; } = new ();
    private List<ReunionDTO> reunionditabla { get; set; } = new ();
    private List<ReunionDTO> reudiatabla { get; set; } = new ();
    private List<AsistenReuDTO> asistenreus { get; set; } = new ();
    private List<CargoReuDTO> cargoreus { get; set; } = new ();
    private List<StatsAsisDto> StatsAsisDtos { get; set; } = new ();
    private List<EquiposEamVDTO> equipos { get; set; } = new ();
    private List<EquiposEamVDTO> equiposlinea { get; set; } = new ();
    private List<EquipoEamDTO> listaEqupis { get; set; } = new ();
    private List<RegistroCambiosDTO> listaRegistro { get; set; } = new ();
    private List<CalendarioTrabajoDTO> calentrabajo { get; set; } = new ();
    private List<CambFecDTO> cambiofecha { get; set; } = new ();
    private List<ReunionDTO> reudiatablas { get; set; } = new ();




    List<ReunionDTO> listareu = new List<ReunionDTO>();//filtar los responsables

    private List<Claim> claims { get; set; } = new ();
    private bool traduccionesCargadas = false;

    private async Task CreateData()

    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);
        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RespoReuData.GetResReu();
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture ?? CultureInfo.InvariantCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture ?? CultureInfo.InvariantCulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;
    }
    
    private readonly List<int> AllowedResponsables = new List<int> { 2, 4, 8, 9, 10, 11 };

    protected override async Task OnParametersSetAsync()
    {
        await CreateData();
        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        await CausaCalidadData.GetCausasCalidad();
        
        var role = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value
            ?? string.Empty;
        var idEmpresa = claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value
            ?? string.Empty;
        var idCentro = claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value
            ?? string.Empty;

        switch (role)
        {
            case "Admin":
            case "SuperAdmin":
                UsrAdmin = "SuperAdmin";
                await MaestraData.GetCentrosxEmpresa("All" + idEmpresa);
                break;

            case "SemiAdmin":
                UsrAdmin = "SemiAdmin";
                await MaestraData.GetCentrosxEmpresa(idCentro);
                break;

            case "Planificador":
            case "SuperUser":
                await MaestraData.GetCentrosxEmpresa(idCentro);
                break;

            case "MttoAdmin":
                UsrRol = "Mtto";
                await MaestraData.GetCentrosxEmpresa("All" + idEmpresa);
                break;

            case "SeguridadAdmin":
                UsrRol = "Seguridad";
                await MaestraData.GetCentrosxEmpresa("All" + idEmpresa);
                break;

            case "CalidadAdmin":
                UsrRol = "Calidad";
                await MaestraData.GetCentrosxEmpresa("All" + idEmpresa);
                break;

            case "Mantenimiento":
                UsrRol = "Mtto";
                await MaestraData.GetCentrosxEmpresa(idCentro);
                break;

            case "Auditores":
                await MaestraData.GetCentrosxEmpresa("All" + idEmpresa);
                break;

            default:
                UsrRol = role;
                await MaestraData.GetCentrosxEmpresa(idCentro);
                break;
        }



    if (!string.IsNullOrWhiteSpace(accion)
        && !string.IsNullOrWhiteSpace(f1)
        && !string.IsNullOrWhiteSpace(f2))
    {
        string[] fec1 = f1.Split('-');
        string[] fec2 = f2.Split('-');

        // año, mes, día
        DateTime date1 = new DateTime(
            int.Parse(fec1[2]),
            int.Parse(fec1[1]),
            int.Parse(fec1[0])
        );

        DateTime date2 = new DateTime(
            int.Parse(fec2[2]),
            int.Parse(fec2[1]),
            int.Parse(fec2[0])
        );

        dataIsLoaded = 1;

        var divisionFinal = division ?? string.Empty;

        PizarraData.reudiatablas =
            await PizarraData.GetPendientes(
                accion,
                divisionFinal,
                date1,
                date2,
                tipo!,
                est!
            ) ?? new List<ReunionDTO>();

        dataIsLoaded = 2;
    }

    }
}