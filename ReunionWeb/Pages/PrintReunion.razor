@layout EmptyLayout
@page "/es/TablaReunion"
@page "/es/TablaReunion/{accion}/{division}/{f1}/{f2}/{tipo}"
@page "/en/TableMeeting"
@page "/en/TableMeeting/{accion}/{division}/{f1}/{f2}/{tipo}"

@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject IMaestraData MaestraData
@inject ICausaCalidadData CausaCalidadData

@using ReunionWeb.Resources
@using System.Globalization



<body>

    @if (PizarraData.reudiatablas.Count() > 0 && dataIsLoaded == 2)
    {


        <BSTable IsStriped="true" IsBordered="true">
            <BSTHead Class="cabecera">
                <BSTR>

                    @*<BSTD>Id</BSTD>*@
                    @*Centro para validar el comedor*@
                    @if (CentroComedor == 11)
                    {
                        <BSTD>@ValidationMessages.NEquipo</BSTD>
                    }
                    else
                    {

                        @*  <BSTD>División</BSTD>*@
                        <BSTD>@ValidationMessages.Area</BSTD>
                        <BSTD>Ksf</BSTD>

                    }

                    <BSTD>@ValidationMessages.CodigoDeEquipo</BSTD>
                    <BSTD ColSpan="4">@ValidationMessages.Discrepancia</BSTD>
                    @* <BSTD>Código</BSTD> *@
                    <BSTD>@ValidationMessages.PlanDeAccion</BSTD>
                    @* <BSTD>Tiempo</BSTD> *@
                    <BSTD ColSpan="1">@ValidationMessages.Responsable</BSTD>
                    <BSTD>@ValidationMessages.DetallesDeCalidad</BSTD>
                    <BSTD>@ValidationMessages.OrgDelProducto</BSTD>
                    <BSTD>Status</BSTD>
                    @* <BSTD>ODT</BSTD> *@
                    <BSTD>@ValidationMessages.FechaDeReunion</BSTD>@*Fecha de listo el trabajo*@


                </BSTR>
            </BSTHead>
            <BSTBody>
                @foreach (var d in PizarraData.reudiatablas)
                {
                    @if (d.Rdstatus != "Listo" & d.RdfecTra <= DateTime.Now | (d.Rdstatus != "Listo" & (d.Rdodt == "" | d.Rdodt
                   is null)))
                    //@if (d.Rdstatus != "Listo")
                    {


                        <BSTR>

                            @*<BSTD>@d.IdReuDia</BSTD>*@
                            @*Centro para validar el comedor*@
                            @if (CentroComedor == 11)
                            {
                                @if (equiposlinea.Any(e => e.CodigoEq == d.RdcodEq) is true)
                                {


                                    @foreach (var eq in equiposlinea)
                                    {

                                        if (eq.CodigoEq == d.RdcodEq)
                                        {
                                            <BSTD>@eq.Equipo</BSTD>

                                        }


                                    }
                                }
                                else
                                {
                                    <BSTD>No hay desctripción.</BSTD>

                                }

                            }
                            else
                            {
                                @*  <BSTD>@d.Rddiv</BSTD>*@
                                <BSTD>@d.Rdarea</BSTD>
                                <BSTD>
                                @{
                                    var texto = idPais == 5 
                                    ? KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfEnglish 
                                    : KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfNombre;
                                }
                                @texto
                                </BSTD>
                            }


                            <BSTD>@d.RdcodEq</BSTD>
                            <BSTD ColSpan="4">@d.Rddisc.ToUpper()</BSTD>
                            @* <BSTD>@d.RdcodDis</BSTD> *@
                            @if (@d.RdplanAcc is not null)
                            {
                                <BSTD Class="textotabla listo">@d.RdplanAcc</BSTD>
                            }
                            else
                            {
                                <BSTD Class="textotabla ">@d.RdplanAcc</BSTD>
                            }
                            @* <BSTD>@d.Rdtiempo</BSTD> *@
                            @if (@KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfNombre == "Por Definir")
                            {
                                <BSTD Class="Definir">@RespoReuData.resporeus.Where( x => x.IdResReu == d.IdResReu).FirstOrDefault()?.Rrnombre </BSTD>
                            }
                            else
                            {
                                <BSTD ColSpan="1">@RespoReuData.resporeus.Where( x => x.IdResReu == d.IdResReu).FirstOrDefault()?.Rrnombre</BSTD>
                            }

                            <BSTD>
                            @{
                                var causa = CausaCalidadData.causaCals.FirstOrDefault(x => x.IdCausaCal == d.IdCausaCal);
                                var texto = idPais == 5 ? causa?.Ccenglish : causa?.Ccnombre;
                            }
                            @texto
                            </BSTD>
                            <BSTD>@d.OrigenCal.ToUpperInvariant()</BSTD>

                            @if (@d.Rdstatus == "Revisar")
                            {
                                <BSTD Class="cabecera">@d.Rdstatus</BSTD>
                            }
                            else
                            {
                                <BSTD Class="">@d.Rdstatus</BSTD>
                            }
                            @* <BSTD>@d.Rdodt</BSTD> *@
                            <BSTD>@d.RdfecTra.ToString("dd/MM/yyyy") </BSTD>


                        </BSTR>

                    }
                }


            </BSTBody>

        </BSTable>

    }
    <button type="button" onclick="window.print()" class="btn btn-success"><span class="oi oi-print"></span></button>
</body>



@code {

    [Parameter]
    public string? accion { get; set; }//centro
    [Parameter]
    public string? division { get; set; }//division
    [Parameter]
    public string? f1 { get; set; }
    [Parameter]
    public string? f2 { get; set; }
    [Parameter]
    public string? tipo { get; set; }

    private List<AsistenReuDTO> listaAsistencia { get; set; }
    private List<LineaDTO> lineas { get; set; }
    private List<DivisionDTO> divisions { get; set; }
    private List<MaestraVDTO> centro { get; set; }
    private List<KsfDTO> ksfs { get; set; }
    private List<RespoReuDTO> resporeu { get; set; }
    private List<ReunionDTO> reunionditabla { get; set; }
    private List<ReunionDTO> reudiatabla { get; set; }
    private List<AsistenReuDTO> asistenreus { get; set; }
    private List<CargoReuDTO> cargoreus { get; set; }
    private List<StatsAsisDto> StatsAsisDtos { get; set; }
    private List<EquiposEamVDTO> equipos { get; set; }
    private List<EquiposEamVDTO> equiposlinea { get; set; }
    private List<EquipoEamDTO> listaEqupis { get; set; }
    private RegistroCambiosDTO listaRegistro { get; set; }
    private List<CalendarioTrabajoDTO> calentrabajo { get; set; }
    private List<CambFecDTO> cambiofecha { get; set; }
    private List<ReunionDTO> reudiatablas { get; set; }
    private List<Claim> claims { get; set; }

    private int idPais { get; set; }




    int dataIsLoaded = 0;
    int CentroComedor = 0;

        private async Task CreateData()

    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
            var culture = new System.Globalization.CultureInfo(paisTemp == 5 ? "en" : "es");
            System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
            await LocalStorage.SetItemAsync("userCulture", culture.Name);
        }

    }

    protected override async Task OnParametersSetAsync()
    {

        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        await CausaCalidadData.GetCausasCalidad();



        if (accion != null)
        {
            dataIsLoaded = 1;
            await PizarraData.GetPendientes(accion, division, DateTime.Now.AddDays(-1), DateTime.Now, tipo, "Reunion");
            dataIsLoaded = 2;
        }

    }
}