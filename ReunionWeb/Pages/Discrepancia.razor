@page "/es/discrepancia"
@page "/en/issue"


@inject ICausaCalidadData CausaCalidadData  
@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject IMaestraData MaestraData
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject NotificationService NotificationService
@inject IDiccionarioTraduccionesService DiccionarioTraduccionesService
@inject LocalizationService LocalizationService
@inject ITranslationService Translator

@using ReunionWeb.Resources
@using System.Globalization
@using ReunionWeb.Services


@attribute [Authorize(Roles = "Admin, AdminChempro, SuperUser, SemiAdmin, SuperAdmin, PrimeUser")]

@if (!traduccionesCargadas || dataIsLoaded == 1)
{
    <div class="loading-container">
        <div class="loader"></div>
    </div>
}
else
{
<h3>@DiccionarioTraduccionesService.Traducciones["Discrepancias"]</h3>

<p></p>

<BSForm Model="Reuniondb" Class="boxhome" IsRow="true" Gutters="Gutters.Medium" OnSubmit="Insert" OnReset="Reset">
    <DataAnnotationsValidator />
    <BSCol ColumnMedium="8">
        @_message
        <BSValidationSummary />
    </BSCol>
    <BSRow>

    
        <BSCol Column="3">
            <BSLabel>@DiccionarioTraduccionesService.Traducciones["Centro"]</BSLabel>
            <BSInput InputType="InputType.Select" @onchange="BuscarDivision" @bind-Value="idCent">
                @if (UsrAdmin == "Admin" || UsrAdmin == "PrimeUser" || IdCentro == 0)
                {
                    <option value="0">@DiccionarioTraduccionesService.Traducciones["Seleccione"]...</option>
                }
                @foreach (var d in MaestraData.centro)
                {
                    <option value="@d.IdCentro">@d.Centro</option>
                }
            </BSInput>
        </BSCol>



        <BSCol Column="3">
            <BSLabel>@DiccionarioTraduccionesService.Traducciones["Division"]</BSLabel>
            <BSInput InputType="InputType.Select" @onchange='BuscarLinea' @bind-Value="idDiv">
                <option value="0">@DiccionarioTraduccionesService.Traducciones["Seleccione"]...</option>
                @if(MaestraData.centro != null){
                    @foreach (var d in MaestraData.divisions)
                    {
                            <option value="@d.IdDivision">@d.Ndivision</option>

                    }
                }
            </BSInput>
        
        </BSCol>


        <BSCol Column="3">
            <BSLabel>@DiccionarioTraduccionesService.Traducciones["Linea"]</BSLabel>
            <BSInput InputType="InputType.Select" @onchange='BuscarEquipo' @bind-Value="idLin">
                <option value="0">@DiccionarioTraduccionesService.Traducciones["Seleccione"]...</option>
                @foreach (var d in MaestraData.lineas)
                {
                    <option value="@d.IdLinea">@d.Linea</option>
                }
            </BSInput>
        
        </BSCol>

    </BSRow>
    <p></p>
    <BSRow>

        <BSCol Column="2">
            <BSRow>
                <BSLabel>@DiccionarioTraduccionesService.Traducciones["Filtrar"]: </BSLabel>
            </BSRow>


            <BSInputRadio CheckedValue="@("0")" @bind-Value="tipoequipo" IsToggle="true" Size="Size.ExtraSmall" Color="BSColor.Success" IsOutlined="true">
                <span class="oi oi-list"></span>
            </BSInputRadio>

            <BSInputRadio CheckedValue="@("1")" @bind-Value="tipoequipo" IsToggle="true" Size="Size.ExtraSmall" Color="BSColor.Success" IsOutlined="true">
                <span class="oi oi-magnifying-glass"></span>
            </BSInputRadio>


        </BSCol>
        @if (MaestraData.centro.Count > 0 & tipoequipo == "0")
        {
          
            @if (Reuniondb.Rdcentro != "Chempro")
            {
                <BSCol Column="4">
                    <BSLabel>@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]</BSLabel>
                    <BSInput InputType="InputType.Select" @bind-Value="Reuniondb.RdcodEq">

                        <option value="">@DiccionarioTraduccionesService.Traducciones["Seleccione"]...</option>
                        @foreach (var d in MaestraData.equipos)
                        {
                                <option value="@d.EcodEquiEam">@d.EcodEquiEam - @d.EnombreEam</option>
                        }


                    </BSInput>

                </BSCol>

            }
            else
            {
                <BSCol Column="4">
                    <BSLabel>@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]</BSLabel>
                    <BSInput InputType="InputType.Text" @bind-Value="Reuniondb.RdcodEq" />
                
                </BSCol>
            }
        }
        else if (MaestraData.centro.Count > 0 & tipoequipo == "1")
        {
            <BSCol Column="4">
                <BSLabel>@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]</BSLabel>
                <div class="autocomplete">
                    <input @bind=selectedEquipoId @oninput=HandleInput class="form-control filter" />
                    @if (equiposfiltro is not null)
                    {
                        <ul class="options">
                            @if (equiposfiltro.Any())
                            {

                                @foreach (var e in equiposfiltro)
                                {
                                        <li class="option" @onclick=@(_ => SelectEquipo(e.EcodEquiEam))>
                                            <span class="option-text">@e.EcodEquiEam - @e.EnombreEam</span>
                                        </li>
                                }
                            }
                            else
                            {
                                <li class="disabled option">No results</li>
                            }
                        </ul>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(selectedEquipoId))
                {
                    <p class="mt-4">
                        @selectedEquipoName - <strong>@selectedEquipoId</strong>
                    </p>
                }
              
            </BSCol>
        }
      


        <BSCol Column="3">
    <BSLabel>Ksf</BSLabel>

    <BSInput InputType="InputType.Select" @bind-Value="Reuniondb.Idksf">
        <option value="">@DiccionarioTraduccionesService.Traducciones["Seleccione"]...</option>
        @foreach (var d in KsfData.ksfs.Where(x => x.Idksf != 6))
        {
            var texto = idPais == 5? d.KsfEnglish : d.KsfNombre;
            <option value="@d.Idksf">@texto</option>
        }
    </BSInput>
</BSCol>

    </BSRow>
    <p></p>
    <BSRow>
        <BSCol Column="9">
            <BSLabel>@DiccionarioTraduccionesService.Traducciones["Discrepancia"]</BSLabel>
            <BSInput InputType="InputType.Text" @bind-Value="Reuniondb.Rddisc" />
        
        </BSCol>
    </BSRow>

    <p></p>

<BSCol Column="3">
    <BSLabel>@DiccionarioTraduccionesService.Traducciones["Responsable"]</BSLabel>
    <BSInput InputType="InputType.Select" @bind-Value="Reuniondb.IdResReu" @onchange="OnResponsableChanged">
        <option value="">@DiccionarioTraduccionesService.Traducciones["Seleccione"]...</option>
        @foreach (var d in RespoReuData.resporeus.Where(x => !ResponsablesExcluidos.ContainsKey(x.IdResReu)))
        {
            var texto = idPais == 5? d.Rrenglish : d.Rrnombre;
            <option value="@d.IdResReu">@texto</option>
        }
    </BSInput>
</BSCol>



@if (IsObservacionesVisible)
{
    <BSCol Column="3">
        <BSLabel>@DiccionarioTraduccionesService.Traducciones["DetallesDeCalidad"]</BSLabel>
        <BSInput InputType="InputType.Select" @bind-Value="Reuniondb.IdCausaCal" @onchange="OnCausaCalidadChanged">
            <option value="">@DiccionarioTraduccionesService.Traducciones["Seleccione"]...</option>
            @foreach (var e in CausaCalidadData.causaCals)
            {
                var texto = idPais == 5? e.Ccenglish : e.Ccnombre;
                <option value="@e.IdCausaCal">@texto</option>
            }
        </BSInput>
    </BSCol>
    <BSCol Column="3">
        <BSLabel>@DiccionarioTraduccionesService.Traducciones["OrgDelProducto"]</BSLabel>
        <BSInput InputType="InputType.Text" @bind-Value="Reuniondb.OrigenCal" />
    </BSCol>
}


    <p></p>

    <BSCol Column="12">
        <BSButton Color="BSColor.Success" Size="Size.ExtraSmall" IsDisabled="isDesactivado" IsSubmit>  @DiccionarioTraduccionesService.Traducciones["Guardar"] <span class="oi oi-check"></span></BSButton>
        <BSButton Color="BSColor.Primary" Size="Size.ExtraSmall" IsReset>  @DiccionarioTraduccionesService.Traducciones["Borrar"] </BSButton>
    </BSCol>



</BSForm>
}

@code {
    private bool IsObservacionesVisible { get; set; } = false;
    
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private List<Claim> claims { get; set; } = new();

   // private string Ubicacion { get; set; } = null;
    ReunionDTO Reuniondb = new ReunionDTO();
    private NotifiRadzen Notificar = new NotifiRadzen();
    private string _message = "";
    private DateTime fechahoy, fechatrabajo = DateTime.Today;
    //private string fechahoy2;
    //private int Idretornado;
    private string tipoequipo { get; set; } = "1";
    CambStatDTO CambStata = new CambStatDTO();
    CambFecDTO CambFech = new CambFecDTO();
    ReunionDTO regisReuDia = new ReunionDTO();
    private string UsrAdmin { get; set; } = ""; 
    private int idCent { get; set; }
    private int idDiv { get; set; }
    private int idLin { get; set; }
    private int idEqui { get; set; }
    //private string mensaje = "";
    //private string Notificacion = "";
    private bool isDesactivado { get; set; } = false;
    private List<AsistenReuDTO> listaAsistencia { get; set; } = new List<AsistenReuDTO>();
    private int IdCentro { get; set; }
    int reunionTurno = 2;
    List<EquipoEamDTO>? equiposfiltro;
    string? selectedEquipoId;
    string? selectedEquipoName;
    string? filter;
    //bool codsuccess = false;

    private int idPais { get; set; }
    private int IdEmpresa { get; set; }
    //private string nombre  { get; set;}
    int dataIsLoaded = 0;
    private bool traduccionesCargadas = false;

        // Diccionario que asocia los IDs con sus nombres
    private readonly Dictionary<int, string> ResponsablesExcluidos = new Dictionary<int, string>
    {
        { 12, "Compras" },
        { 13, "Mtto. Instrumentación" },
        { 15, "Mtto. Infraestructura" },
        { 16, "Efluentes" }
    };

    protected override async Task OnInitializedAsync()
    {
        await CreateData();
        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        await CausaCalidadData.GetCausasCalidad();
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture ?? CultureInfo.InvariantCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture ?? CultureInfo.InvariantCulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;

        Reuniondb.IdCausaCal = 1;
        Reuniondb.OrigenCal = "";

        var UsrAdmin = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value?? string.Empty;
        var idEmpresa = claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value?? string.Empty;
        var idCentroClaim = claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value?? string.Empty;


        // --- Cargar centros según el UsrAdmin ---
        var esRolConAll = UsrAdmin == "Admin" || UsrAdmin == "SuperAdmin" || UsrAdmin == "PrimeUser";
        if (esRolConAll && !string.IsNullOrWhiteSpace(idEmpresa))
        {
            await MaestraData.GetCentrosxEmpresa("All" + idEmpresa);
        }
        else
        {
            await MaestraData.GetCentrosxEmpresa(idCentroClaim);
        }

        // Inicializaciones
        idCent = 0;
        idDiv = 0;
        idLin = 0;
        idEqui = 0;

        // Filtrar responsables
        RespoReuData.resporeus = RespoReuData.resporeus
            .Where(a => a.Rrdesc == claims.FirstOrDefault(c => c.Type.Contains("Empresa"))?.Value
                    || string.IsNullOrEmpty(a.Rrdesc))
            .ToList();

        // --- Decisión: mantener "Seleccione" para Admin/SuperAdmin/PrimeUser ---
        if (esRolConAll)
        {
            // Mantener placeholder: no seleccionar automáticamente
            idCent = 0;
            // No se llama BuscarDivision aún (no hay centro elegido)
        }
        else
        {
            // Otros roles: seleccionar automáticamente
            await SetCentroInicialAsync();
        }
    }

    private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = user.Claims.ToList();

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }

        var idEmpresaClaim = claims.FirstOrDefault(c => c.Type == "IdEmpresa")?.Value;
        if (int.TryParse(idEmpresaClaim, out var empresaTemp))
        {
            IdEmpresa = empresaTemp;
        }

    }

    private async Task SetCentroInicialAsync()
    {
        // Verificar que la lista esté lista
        if (MaestraData?.centro == null || !MaestraData.centro.Any())
            return;

        // Tomar IdCentro del claim si existe
        var idCentroClaimStr = claims?.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value;
        int.TryParse(idCentroClaimStr, out var idCentroClaim);

        // Si el claim está en la lista, úsalo; si no, usa el primero
        if (idCentroClaim > 0 && MaestraData.centro.Any(x => x.IdCentro == idCentroClaim))
        {
            idCent = idCentroClaim;
        }
        else
        {
            idCent = MaestraData.centro.First().IdCentro;
        }

        // Disparar lógica dependiente manualmente (porque cambiar por código no invoca @onchange)
        await BuscarDivision(new ChangeEventArgs { Value = idCent });

        StateHasChanged();
        }

    private void OnResponsableChanged(ChangeEventArgs e)
    {
        var selectedResponsableId = e.Value?.ToString();

        if (!string.IsNullOrEmpty(selectedResponsableId))
        {
            Reuniondb.IdResReu = int.Parse(selectedResponsableId);
            Reuniondb.Responsable = RespoReuData.resporeus
                .FirstOrDefault(k => k.IdResReu == Reuniondb.IdResReu)?.Rrnombre;

            IsObservacionesVisible = Reuniondb.IdResReu == 9;

            // Si el responsable es 9, limpiar el campo de Ubicación
            if (Reuniondb.IdResReu == 9)
            {
                Reuniondb.OrigenCal = ""; // Limpiamos el valor de Ubicación
            }
            else
            {
                Reuniondb.IdCausaCal = 1;
                Reuniondb.OrigenCal = "N/A";
            }

        }
        else
        {
            IsObservacionesVisible = false;
            Reuniondb.IdCausaCal = 1;
            Reuniondb.OrigenCal = "";
        }

        StateHasChanged();
    }

    private void OnCausaCalidadChanged(ChangeEventArgs e)
    {
        var selectedCausaCalId = e.Value?.ToString();
        Reuniondb.IdCausaCal = string.IsNullOrEmpty(selectedCausaCalId) ? 1 : int.Parse(selectedCausaCalId);
        StateHasChanged();
    }

    private void OnUbicacionChanged(ChangeEventArgs e)
    {
        // Obtiene el valor del evento y asigna "N/A" si es nulo o vacío
        Reuniondb.OrigenCal = e?.Value?.ToString() ?? string.Empty;    
        // Notifica a Blazor que el estado del componente ha cambiado
        StateHasChanged();
    }

    protected async Task BuscarDivision(ChangeEventArgs e)
    {
        idDiv = idLin = idEqui = 0;

        if (e?.Value is not string valor || !int.TryParse(valor, out var centroId))
        {
            idCent = 0;
            return;
        }

        idCent = centroId;

        if (idCent == 0)
            return;

        try
        {
            MaestraData.divisions =
                await MaestraData.ObtenerDivisionDelCentro(idCent);
        }
        catch
        {
            NotificationService.Notify(
                Notificar.Notificacion(
                    "error",
                    "Error",
                    DiccionarioTraduccionesService.Traducciones["SCentro"]
                )
            );
        }
    }

    protected async Task BuscarLinea(ChangeEventArgs e)
    {
        idLin = idEqui = 0;

        if (e?.Value is not string valor || !int.TryParse(valor, out var divisionId))
        {
            idDiv = 0;
            return;
        }

        idDiv = divisionId;

        if (idCent == 0 || idDiv == 0)
            return;

        try
        {
            MaestraData.lineas =
                await MaestraData.ObtenerLasLineasPorDivision(idDiv);
        }
        catch
        {
            NotificationService.Notify(
                Notificar.Notificacion(
                    "error",
                    "Error",
                    DiccionarioTraduccionesService.Traducciones["SDivision"]
                )
            );
        }
    }

    protected async Task BuscarEquipo(ChangeEventArgs e)
    {
        idEqui = 0;

        if (e?.Value is not string valor || !int.TryParse(valor, out var lineaId))
        {
            idLin = 0;
            return;
        }

        idLin = lineaId;

        await BuscarIdMaster(idLin);

        if (idCent == 0 || idLin == 0)
            return;

        try
        {
            MaestraData.equipos =
                await MaestraData.GetEquiposEAMPorLinea(idLin);
        }
        catch
        {
            NotificationService.Notify(
                Notificar.Notificacion(
                    "error",
                    "Error",
                    DiccionarioTraduccionesService.Traducciones["SArea"]
                )
            );
        }
    }

    protected async Task BuscarIdMaster(int e)
    {
        idLin = e;

        if (idCent == 0)
            return;

        try
        {
            MaestraData.maestra =
                await MaestraData.GetMaestraXLinea(idLin);
        }
        catch
        {
            NotificationService.Notify(
                Notificar.Notificacion(
                    "error",
                    "Error",
                    DiccionarioTraduccionesService.Traducciones["ErrorInser"]
                )
            );
        }
    }

    protected async Task Insert(EditContext d)
    {
        try
        {
            var maestraItem = MaestraData.maestra.FirstOrDefault(x => x.IdLinea == idLin);
            var lineaItem = MaestraData.lineas.FirstOrDefault(x => x.IdLinea == idLin);
            var centroItem = MaestraData.centro.FirstOrDefault(c => c.IdCentro == idCent);

        if (maestraItem == null || lineaItem == null || centroItem == null)
        {
            NotificationService.Notify(Notificar.Notificacion("error", DiccionarioTraduccionesService.Traducciones["ErrorInesp"], DiccionarioTraduccionesService.Traducciones["NSDatos"]));
            return;
        }

        Reuniondb.IdMaster = maestraItem.IdMaster;
        Reuniondb.Rdarea = lineaItem.Linea;
        Reuniondb.Rdstatus = "Pendiente";
        Reuniondb.IdTipReu = reunionTurno;
        Reuniondb.IdPais = idPais;
        Reuniondb.IdEmpresa = IdEmpresa;
        Reuniondb.Ksf = KsfData.ksfs.FirstOrDefault(k => k.Idksf == Reuniondb.Idksf)?.KsfNombre ?? "";

        if (tipoequipo == "1")
            Reuniondb.RdcodEq = selectedEquipoId;

        if (d.Validate())
        {
            Reuniondb.RdfecCrea = DateTime.Now;
            Reuniondb.RdfecReu = fechahoy = DateTime.Now;
            Reuniondb.RdfecTra = fechatrabajo;
            Reuniondb.Rdcentro = centroItem.Centro;
            Reuniondb.Rddiv = MaestraData.divisions.FirstOrDefault(e => e.IdDivision == idDiv)?.Ndivision;

            if (ValidateFields(Reuniondb))
            {
                CambStata = new CambStatDTO
                {
                    Cbfecha = DateTime.Now,
                    Cbstat = "Pendiente",
                    Cbuser = claims[2].Value + " " + claims[3].Value
                };

                CambFech = new CambFecDTO
                {
                    Cffec = DateTime.Now,
                    CffecNew = DateTime.Now,
                    Cfuser = claims[2].Value + " " + claims[3].Value
                };

                var result = await AvisadorData.InsertarRegistros(new RegistroCambiosDTO(CambFech, CambStata, Reuniondb));
                if (result)
                {
                    ResetFields();
                    NotificationService.Notify(Notificar.Notificacion("exito", DiccionarioTraduccionesService.Traducciones["RExitoso"], ""));
                }
                else
                {
                    NotificationService.Notify(Notificar.Notificacion("error", DiccionarioTraduccionesService.Traducciones["ErrorInser"], ""));
                }
            }
        }
    }
    catch (Exception ex)
    {
        NotificationService.Notify(Notificar.Notificacion("error",  DiccionarioTraduccionesService.Traducciones["ErrorInesp"], ex.Message));
    }

    IsObservacionesVisible = false;
    isDesactivado = false;
    }


    private bool ValidateFields(ReunionDTO reunion)
    {
        if (string.IsNullOrEmpty(reunion.Rdarea))
        {
            NotifyError(DiccionarioTraduccionesService.Traducciones["SArea"]);
            return false;
        }
        if (string.IsNullOrEmpty(reunion.Rddiv))
        {
            NotifyError(DiccionarioTraduccionesService.Traducciones["SDivision"]);
            return false;
        }
        if (string.IsNullOrEmpty(reunion.Rddisc))
        {
            NotifyError(DiccionarioTraduccionesService.Traducciones["LlDisp"]);
            return false;
        }
        if (string.IsNullOrEmpty(reunion.Rdstatus))
        {
            NotifyError(DiccionarioTraduccionesService.Traducciones["SEstado"]);
            return false;
        }
        return true;
    }

    private void NotifyError(string message)
    {
        NotificationService.Notify(Notificar.Notificacion("advertencia", message, ""));
    }

    private void ResetFields()
    {
        Reuniondb = new ReunionDTO();
        CambStata = new CambStatDTO();
        CambFech = new CambFecDTO();
        idDiv = 0;
        idLin = 0;
        idEqui = 0;
        fechatrabajo = DateTime.Today;
        selectedEquipoId = selectedEquipoName = null;
        equiposfiltro = null;
    }

    protected void Reset()
    {
        ResetFields();
    }

    void HandleInput(ChangeEventArgs d)
    {
        filter = d.Value?.ToString();

        equiposfiltro = !string.IsNullOrEmpty(filter)
            ? MaestraData.equipos
                .Where(a => a.EcodEquiEam.Contains(filter, StringComparison.OrdinalIgnoreCase))
                .ToList()
            : null;

        selectedEquipoName = selectedEquipoId = null;
    }

    void SelectEquipo(string id)
    {
        selectedEquipoId = id;
        selectedEquipoName = equiposfiltro!.First(c => c.EcodEquiEam.Equals(selectedEquipoId)).EnombreEam;
        equiposfiltro = null;
    }

}
