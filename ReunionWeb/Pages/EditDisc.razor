        </BSTable>
    </div>
}





@code {
    private int idPais { get; set; }

    private bool IsDiscObservacionesVisible { get; set; } = false;
    private bool ObservacionesGuardadas { get; set; } = false;
    private int? PreviousCausaCal { get; set; } = null;
    
    [Parameter] public int? Id { get; set; }
    [Parameter] public int? tipo { get; set; }
    [Parameter] public string? f1 { get; set; }
    [Parameter] public string? linea { get; set; }
    [Parameter] public string? f2 { get; set; }
    [Parameter] public string? est { get; set; }
    
    string _message = "";
    bool cambio = true;
    bool loader = true;
    
    ReunionDTO DiscForm = new ReunionDTO();
    CambStatDTO CambStat = new CambStatDTO();
    CambFecDTO CambFec = new CambFecDTO();
    List<CambFecDTO> CambiosFecha = new List<CambFecDTO>();
    
    private NotifiRadzen Notificar = new NotifiRadzen();
    private DateTime fechahoy, fechatrabajo = DateTime.Today;
    private string fechahoy2, Emp = "";
    private string planificador, camStat, PlanOld;
    private DateTime? camFec;
    private List<Claim> claims { get; set; }
    
    private readonly List<int> ResponsablesPermitidos = new() { 2, 4, 8, 9, 10, 11 };
    
    private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = user.Claims.ToList();

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
            var culture = new System.Globalization.CultureInfo(paisTemp == 5 ? "en" : "es");
            System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
            await LocalStorage.SetItemAsync("userCulture", culture.Name);
        }
    }
    
    protected override async Task OnParametersSetAsync()
    {
        await CreateData();
        loader = true;
        Emp = claims[5].Value;
        planificador = claims[1].Value;
        await AvisadorData.GetCambioFecha((int)Id);
        CambiosFecha = AvisadorData.cambiofecha;
        camStat = DiscForm.Rdstatus;
        camFec = DiscForm.RdfecTra;
        PlanOld = DiscForm.RdplanAcc;
        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        await CausaCalidadData.GetCausasCalidad();
        loader = false;
    }
    
    private void OnDiscResponsableChanged(ChangeEventArgs e)
    {
        var selectedResponsableId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(selectedResponsableId))
        {
            if (DiscForm.IdResReu == 9 && PreviousCausaCal.HasValue)
                ObservacionesGuardadas = true;
            else
                ObservacionesGuardadas = false;

            DiscForm.IdResReu = int.Parse(selectedResponsableId);

            if (DiscForm.IdResReu == 9)
            {
                IsDiscObservacionesVisible = true;
                if (DiscForm.IdCausaCal == null || DiscForm.IdCausaCal == 0)
                    DiscForm.IdCausaCal = 1;
                DiscForm.OrigenCal = "";
            }
            else
            {
                IsDiscObservacionesVisible = false;
                DiscForm.IdCausaCal = 1;
                PreviousCausaCal = DiscForm.IdCausaCal;
                if (!string.IsNullOrEmpty(DiscForm.OrigenCal))
                    DiscForm.OrigenCal = "N/A";
            }
        }
        else
        {
            IsDiscObservacionesVisible = false;
            DiscForm.IdCausaCal = 1;
            if (string.IsNullOrEmpty(DiscForm.OrigenCal))
                DiscForm.OrigenCal = "N/A";
        }
        StateHasChanged();
    }
    
    private void OnCausaCalidadChanged(ChangeEventArgs e)
    {
        DiscForm.IdCausaCal = !string.IsNullOrEmpty(e.Value?.ToString()) ? int.Parse(e.Value.ToString()) : 1;
        StateHasChanged();
    }
    
    private void OnUbicacionChanged(ChangeEventArgs e)
    {
        DiscForm.OrigenCal = !string.IsNullOrEmpty(e.Value?.ToString()) ? e.Value.ToString() : "";
        StateHasChanged();
    }
    
    protected override async Task OnInitializedAsync()
    {
        DiscForm = await PizarraData.GetDiscrepantacia((int)Id);
        IsDiscObservacionesVisible = DiscForm.IdResReu == 9;
        base.OnInitialized();
    }
    
    async Task Back()
    {
        string backcentro = DiscForm.Rdcentro;
        string backdiv = DiscForm.Rddiv;
        int currentIdCausaCal = DiscForm.IdCausaCal;
        CentroDivisionDTO centrodiv = await PizarraData.GetCentroDivi(backcentro, backdiv, 1);
        string lang = idPais == 5 ? "en" : "es";
        string ruta = "";
        if (tipo == 0 || tipo == 2)
        {
            ruta = $"{lang}/{(lang == "en" ? "remaining" : "pendientes")}/{centrodiv.IdCentro}/{centrodiv.IdDivision}/{linea}/{f1}/{f2}/{tipo}/{est}";
        }
        else if (tipo == 1)
        {
            ruta = $"{lang}/{(lang == "en" ? "meeting" : "reunion")}/{centrodiv.IdCentro}/{centrodiv.IdDivision}/{linea}/{f1}/{f2}/{tipo}/{est}";
        }
        NavigationManager.NavigateTo(ruta, true);
        DiscForm.IdCausaCal = currentIdCausaCal;
    }

    
    async Task Editar()
    {
        try
        {
            if (tipo == 1 || tipo == 0 || tipo == 2)
            {
                if (CambiosFecha.Count() >= 3 && camFec != DiscForm.RdfecTra)
                    return;
                if (string.IsNullOrEmpty(DiscForm.RdplanAcc) && DiscForm.Rdstatus == "Cerrado")
                {
                    NotificationService.Notify(Notificar.Notificacion("advertencia", ValidationMessages.Atencion, ValidationMessages.NPA1));
                    return;
                }
                if (PlanOld != DiscForm.RdplanAcc && string.IsNullOrEmpty(DiscForm.RdplanAcc))
                {
                    NotificationService.Notify(Notificar.Notificacion("advertencia", ValidationMessages.Atencion, ValidationMessages.NPA2));
                    DiscForm.RdplanAcc = PlanOld;
                    return;
                }
                if (camStat != DiscForm.Rdstatus)
                {
                    CambStat.IdReuDia = DiscForm.IdReuDia;
                    CambStat.Cbfecha = DateTime.Now;
                    CambStat.Cbstat = DiscForm.Rdstatus;
                    CambStat.Cbuser = claims[2].Value + " " + claims[3].Value;
                }
                if (camFec != DiscForm.RdfecTra)
                {
                    CambFec.IdReuDia = DiscForm.IdReuDia;
                    CambFec.Cffec = DateTime.Now;
                    CambFec.CffecNew = DiscForm.RdfecTra;
                    CambFec.Cfuser = claims[2].Value + " " + claims[3].Value;
                }
                await AvisadorData.InsertCambioStatus(CambStat);
                await AvisadorData.InsertCambioFec(CambFec);
                var (success, centro, div) = await PizarraData.UpdateDiscrepancia2(DiscForm, (int)Id);
                if (success)
                {
                    string lang = idPais == 5 ? "en" : "es";
                    string ruta = "";
                    if (tipo == 0 || tipo == 2)
                    {
                        ruta = $"{lang}/{(lang == "en" ? "remaining" : "pendientes")}/{centro}/{div}/{linea}/{f1}/{f2}/{tipo}/{est}";
                    }
                    else if (tipo == 1)
                    {
                        ruta = $"{lang}/{(lang == "en" ? "meeting" : "reunion")}/{centro}/{div}/{linea}/{f1}/{f2}/{tipo}/{(lang == "en" ? "Meeting" : "Reunion")}";
                    }
                    NavigationManager.NavigateTo(ruta, true);
                }
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(Notificar.Notificacion("error", ValidationMessages.ErrorInesp, ValidationMessages.Reload));
        }
    }
}