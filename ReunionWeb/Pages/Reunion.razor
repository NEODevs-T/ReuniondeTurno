@page "/es/reunion"
@page "/es/reunion/{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}"
@page "/en/meeting"
@page "/en/meeting/{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}"
@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject ICausaCalidadData CausaCalidadData
@inject IMaestraData MaestraData
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime IJS
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject ILocalStorageService LocalStorage
@using ReunionWeb.Resources

<h3>@ValidationMessages.FormatoDeReunion</h3>


<BSContainer>

    @if (MaestraData.centro.Count() == 0)
    {


        <div class="loader"></div>
    }
    else
    {
        @error
        <BSRow>
            <BSCol Column="3" ColumnSmall="2">
                <BSLabel>@ValidationMessages.Centro</BSLabel>
                <BSInput InputType="InputType.Select" @onchange="BuscarDivision" @bind-Value="IdCentro">
                    <option value="0">@ValidationMessages.Seleccione</option>
                    @foreach (var d in MaestraData.centro)
                    {
                        <option value="@d.IdCentro">@d.Centro</option>
                    }
                </BSInput>
            </BSCol>

            <BSCol Column="3">
                <BSLabel>@ValidationMessages.Division</BSLabel>
                <BSInput InputType="InputType.Select" @bind-Value="IdDiv">
                    <option value="0">@ValidationMessages.Seleccione</option>
                    @foreach (var d in MaestraData.divisions)
                    {
                            <option value="@d.IdDivision">@d.Ndivision</option>
                    }
                </BSInput>
            </BSCol>

            <BSCol Column="3" ColumnSmall="2">
                <BSLabel>@ValidationMessages.Codigo</BSLabel>
                <BSInput InputType="InputType.Select" IsDisabled @bind-Value="Codigo">
                    <option value="Todo">@ValidationMessages.EnCurso</option>
                    <option value="6">@ValidationMessages.EnCurso</option>
                </BSInput>
            </BSCol>
            <BSCol Column="2">
                <BSRow>
                    <BSLabel>@ValidationMessages.Aceptar</BSLabel>
                </BSRow>
                <BSButton IsOutlined Color="BSColor.Success" Size="Size.ExtraSmall" @onclick="Get"> Reunión <span
                        class="oi oi-check"></span></BSButton>
            </BSCol>
            @if (PizarraData.reudiatablas.Count() > 0 && dataIsLoaded == 2)
            {
                <BSCol ColumnSmall="2">
                    <BSRow>
                        <BSLabel>@ValidationMessages.Imprimir</BSLabel>
                    </BSRow>
                    <BSButton IsOutlined Color="BSColor.Success" Size="Size.ExtraSmall" @onclick="PrintDocument"> <span
                            class="oi oi-print"></span></BSButton>
                </BSCol>
            }
        </BSRow>
    }

</BSContainer>

<p>
</p>

@if (PizarraData.reudiatablas.Count() > 0 && dataIsLoaded == 2)
{
    <BSContainer>

        <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
            <BSTHead Class="cabecera">
                <BSTR>

                    @*<BSTD>Id</BSTD>*@

                    <BSTD>@ValidationMessages.Area</BSTD>
                    <BSTD>Ksf</BSTD>
                    <BSTD>@ValidationMessages.CodigoDeEquipo</BSTD>
                    <BSTD>@ValidationMessages.NombreDelEquipo</BSTD>
                    <BSTD ColSpan="4">@ValidationMessages.Discrepancia</BSTD>
                    @* <BSTD>Código</BSTD> *@
                    <BSTD>@ValidationMessages.PlanDeAcción</BSTD>
                    @* <BSTD>Tiempo</BSTD> *@
                    <BSTD ColSpan="1">@ValidationMessages.Responsable</BSTD>
                    <BSTD>@ValidationMessages.DetallesDeCalidad</BSTD>
                    <BSTD>@ValidationMessages.OrgDelProducto</BSTD>
                    <BSTD>Status</BSTD>
                    @* <BSTD>ODT</BSTD> *@
                    <BSTD>Fecha de Reunión</BSTD>@*Fecha de listo el trabajo*@
                    @if (Rol == "Admin" | Rol == "AdminChempro" | Rol == "SuperUser" | Rol == "SemiAdmin")
                    {
                        <BSTD></BSTD>

                    }

                </BSTR> 
            </BSTHead>
            <BSTBody>
                @foreach (var d in PizarraData.reudiatablas)
                {
                    @if (d.Rdstatus != "Rechazada" && d.Rdstatus != "Listo" & d.RdfecTra <= DateTime.Now | (d.Rdstatus != "Listo" & (d.Rdodt == "" | d.Rdodt is null)))
                    //@if (d.Rdstatus != "Listo")
                    {
                        @if (Codigo == d.RdcodDis | Codigo == "Todo")
                        @if (Origencalidad == "Todo" || Origencalidad == d.OrigenCal)
                        {

                            <BSTR>

                                @*<BSTD>@d.IdReuDia</BSTD>*@
                                @* <BSTD>@d.Rddiv</BSTD>*@
                                <BSTD>@d.Rdarea</BSTD>
                                <BSTD>
                                @{
                                    var texto = idPais == 5 
                                        ? KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfEnglish 
                                        : KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfNombre;
                                }
                                @texto
                                </BSTD>
                                <BSTD>@d.RdcodEq</BSTD>
                                <BSTD>@(string.IsNullOrWhiteSpace(d.EnombreEam) ? "EQUIPO NO ENCONTRADO" : d.EnombreEam)</BSTD>
                                <BSTD ColSpan="4">@d.Rddisc.ToUpper()</BSTD>
                                @* <BSTD>@d.RdcodDis</BSTD> *@
                                @if (@d.RdplanAcc is not null)
                                {
                                    <BSTD Class="textotabla listo">@d.RdplanAcc</BSTD>
                                }
                                else
                                {
                                    <BSTD Class="textotabla ">@d.RdplanAcc</BSTD>
                                }
                                @* <BSTD>@d.Rdtiempo</BSTD> *@
                                @if (@RespoReuData.resporeus.Where( x => x.IdResReu == d.IdResReu).FirstOrDefault()?.Rrnombre == "Por Definir")
                                {
                                    <BSTD Class="Definir">@RespoReuData.resporeus.Where( x => x.IdResReu == d.IdResReu).FirstOrDefault()?.Rrnombre</BSTD>
                                }
                                else
                                {
                                    <BSTD ColSpan="1">@RespoReuData.resporeus.Where( x => x.IdResReu == d.IdResReu).FirstOrDefault()?.Rrnombre</BSTD>
                                }

                                <BSTD>@CausaCalidadData.causaCals.Where(x => x.IdCausaCal == d.IdCausaCal).FirstOrDefault()?.Ccnombre</BSTD>
                                <BSTD>@d.OrigenCal.ToUpperInvariant()</BSTD>


                                @if (@d.Rdstatus == "Revisar")
                                {
                                    <BSTD Class="cabecera">@d.Rdstatus</BSTD>
                                }
                                else
                                {
                                    <BSTD Class="">@d.Rdstatus</BSTD>
                                }
                                @* <BSTD>@d.Rdodt</BSTD> *@
                                <BSTD>@d.RdfecTra.ToString("dd/MM/yyyy") </BSTD>
                                @if (Rol == "Admin" | Rol == "AdminChempro" | Rol == "SuperUser" | Rol == "SemiAdmin")
                                {
                                    <BSTD>
                                        <button class="btn btn-success" @onclick="(() => Editar(d.IdReuDia))"><i
                                                class="oi oi-pencil"></i></button>
                                    </BSTD>
                                }

                            </BSTR>
                        }
                    }
                }


            </BSTBody>

        </BSTable>
    </BSContainer>
}
else if (dataIsLoaded == 1 && PizarraData.reudiatablas.Count() == 0)
{
    <div class="loader"></div>
}
else if (dataIsLoaded == 2 && PizarraData.reudiatablas.Count() == 0)
{
<div style="text-align: center; padding: 20px; font-size: 18px; color: rgb(102, 101, 101);">
    <p>No hay datos para esta fecha.</p>
</div>
}

@code {

    [Parameter]
    public string? accion { get; set; }//centro
    [Parameter]
    public string? division { get; set; }//division
    [Parameter]
    public string? linea { get; set; }//linea
    [Parameter]
    public string? f1 { get; set; }
    [Parameter]
    public string? f2 { get; set; }
    [Parameter]
    public string? tipo { get; set; }
    [Parameter]
    public string? est { get; set; }


    int dataIsLoaded = 0, filtrocod = 0;
    string ayer = DateTime.Now.AddDays(-1).ToString("yyyyMMdd");
    string error;
    
    private string? Origencalidad { get; set; } ="Todo";
    private int IdCentro { get; set; } = 0; //id del Centro
    private int IdDiv { get; set; } = 0; //id de la division
    private int CentroComedor;//Variable para verificar si es el comedor venezuela;
    private NotifiRadzen Notificar = new NotifiRadzen();//Logic para crear las noyificaciones radzen


    //private string Div { get; set; } //Centro
    //private string Division { get; set; } //División


    private string Codigo { get; set; } = "Todo"; //Codigo
    private string Rol { get; set; } = ""; //Rol del usuario

    private string mensaje {get; set; } = "";

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private int idPais { get; set; }



    private List<Claim> claims { get; set; }

    private async Task CreateData()

    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);

    }

    protected override async Task OnInitializedAsync()
    {
        await CreateData();
        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        int paisTemp;

        if (int.TryParse(idPaisClaim, out paisTemp) && paisTemp == 5)
        {
            idPais = paisTemp;
            var culture = new System.Globalization.CultureInfo("en");
            System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
            await LocalStorage.SetItemAsync("userCulture", "en");
        }
        else
        {
            var culture = new System.Globalization.CultureInfo("es");
            System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
            await LocalStorage.SetItemAsync("userCulture", "es");
        }
        Rol = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value;


        if (Rol == "Admin" || Rol == "SuperAdmin" || Rol == "MttoAdmin" || Rol == "SeguridadAdmin" || Rol == "CalidadAdmin" ||
        Rol == "Auditores")
        {
            // await apiclass.GetCentros("All");
            await MaestraData.GetCentrosxEmpresa("All" + claims[10].Value);
        }
        else
        {
            //await apiclass.GetCentros(claims[6].Value.ToString());
            await MaestraData.GetCentrosxEmpresa(claims[11].Value);
        }


        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        await CausaCalidadData.GetCausasCalidad();


    }

    protected async Task BuscarDivision(ChangeEventArgs e)
    {
            IdCentro = int.Parse(e.Value.ToString());
            IdDiv = 0;
            try{
                if(IdCentro != 0){
                    MaestraData.divisions = await MaestraData.ObtenerDivisionDelCentro(IdCentro);
                }
            }catch(Exception ex){
                mensaje = "Error: " + ex.Message;
            }
    }


protected async Task Get()
{
    if (IdCentro != 0 && IdDiv != 0)
    {
        error = null;

        if (dataIsLoaded != 1)
        {
            dataIsLoaded = 1;

            // Definir el rango de fechas para el día de ayer y hoy
            DateTime fechaInicio = DateTime.Today.AddDays(-1); // Ayer
            DateTime fechaFin = DateTime.Today.AddDays(1).AddTicks(-1); // Fin del día de hoy

            // Obtener los datos
            await PizarraData.GetPendientes(
                IdCentro.ToString(),
                IdDiv.ToString(),
                fechaInicio,
                fechaFin,
                "1",
                "Reunion"
            );

            // Filtrar los datos para asegurar que solo queden reuniones del día de ayer y hoy
            if (PizarraData.reudiatablas != null)
            {
                PizarraData.reudiatablas = PizarraData.reudiatablas
                    .Where(r => r != null && (r.RdfecReu.Date == DateTime.Today || r.RdfecReu.Date == DateTime.Today.AddDays(-1))) // Filtrar por la fecha de reunión
                    .ToList();
            }

            dataIsLoaded = 2;
        }
    }
    else
    {
        NotificationService.Notify(Notificar.Notificacion("advertencia", "Atención", "Seleccione los valores en las listas"));
    }
}

void Editar(int id)
{
    // Usar la fecha de hoy formateada en el formato "dd-MM-yyyy"
    string fechaHoy = DateTime.Today.ToString("dd-MM-yyyy");
    NavigationManager.NavigateTo($"EditDisc/{id}/1/Re/{fechaHoy}/{fechaHoy}/Reunion");
}

protected override async Task OnParametersSetAsync()
{
    if (accion != null)
    {
        dataIsLoaded = 1;

        IdCentro = int.Parse(accion);
        IdDiv = int.Parse(division);

        // Definir el rango de fechas para el día actual
        DateTime fechaHoyInicio = DateTime.Today;
        DateTime fechaHoyFin = DateTime.Today.AddDays(1).AddTicks(-1);

        // Obtener los datos
        await PizarraData.GetPendientes(
            accion,
            division,
            fechaHoyInicio,
            fechaHoyFin,
            tipo,
            "Reunion"
        );

        // Filtrar los datos para mostrar solo las reuniones del día actual
        if (PizarraData.reudiatablas != null)
        {
            PizarraData.reudiatablas = PizarraData.reudiatablas
                .Where(r => r != null && r.RdfecReu.Date == DateTime.Today) // Filtrar por fecha de reunión
                .ToList();
        }

        dataIsLoaded = 2;
    }
}

    public async Task PrintDocument()
    {
        await IJS.InvokeAsync<object>("open", new object[] { $"TablaReunion/{IdCentro.ToString()}/{IdDiv.ToString()}/{DateTime.Now.AddDays(-1).ToString("dd-MM-yyyy")}/{DateTime.Now.ToString("dd-MM-yyyy")}/1", "_blank" });
    }


}