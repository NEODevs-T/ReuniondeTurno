@page "/es/reunion"
@page "/es/reunion/{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}"
@page "/en/meeting"
@page "/en/meeting/{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}"
@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject ICausaCalidadData CausaCalidadData
@inject IMaestraData MaestraData
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime IJS
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject ILocalStorageService LocalStorage
@inject IDiccionarioTraduccionesService DiccionarioTraduccionesService
@inject LocalizationService LocalizationService
@inject ITranslationService Translator

@using ReunionWeb.Resources
@using System.Globalization
@using ReunionWeb.Services

<BSContainer>

    @if (!traduccionesCargadas || MaestraData.centro.Count() == 0)
    {


        <div class="loader"></div>
    }
    else
    {
        @error
        <h3>@DiccionarioTraduccionesService.Traducciones["FormatoDeReunion"]</h3>
        <BSRow>
            <BSCol Column="3" ColumnSmall="2">
                <BSLabel>@DiccionarioTraduccionesService.Traducciones["Centro"]</BSLabel>
                <BSInput InputType="InputType.Select" @onchange="BuscarDivision" @bind-Value="IdCentro">
                @if (Rol == "Admin" || Rol == "PrimeUser" || IdCentro == 0)
                {
                    <option value="0">@DiccionarioTraduccionesService.Traducciones["Seleccione"]</option>
                }
                @foreach (var d in MaestraData.centro)
                {
                    <option value="@d.IdCentro">@d.Centro</option>
                }
                </BSInput>
            </BSCol>

            <BSCol Column="3">
                <BSLabel>@DiccionarioTraduccionesService.Traducciones["Division"]</BSLabel>
                <BSInput InputType="InputType.Select" @bind-Value="IdDiv">
                    <option value="0">@DiccionarioTraduccionesService.Traducciones["Seleccione"]</option>
                    @foreach (var d in MaestraData.divisions)
                    {
                            <option value="@d.IdDivision">@d.Ndivision</option>
                    }
                </BSInput>
            </BSCol>

            <BSCol Column="3" ColumnSmall="2">
                <BSLabel>@DiccionarioTraduccionesService.Traducciones["Codigo"]</BSLabel>
                <BSInput InputType="InputType.Select" IsDisabled @bind-Value="Codigo">
                    <option value="Todo">@DiccionarioTraduccionesService.Traducciones["EnCurso"]</option>
                    <option value="6">@DiccionarioTraduccionesService.Traducciones["EnCurso"]</option>
                </BSInput>
            </BSCol>
            <BSCol Column="2">
                <BSRow>
                    <BSLabel>@DiccionarioTraduccionesService.Traducciones["Aceptar"]</BSLabel>
                </BSRow>
                <BSButton IsOutlined Color="BSColor.Success" Size="Size.ExtraSmall" @onclick="Get"> @DiccionarioTraduccionesService.Traducciones["Reunion"] <span
                        class="oi oi-check"></span></BSButton>
            </BSCol>
            @if (PizarraData.reudiatablas.Count() > 0 && dataIsLoaded == 2)
            {
                <BSCol ColumnSmall="2">
                    <BSRow>
                        <BSLabel>@DiccionarioTraduccionesService.Traducciones["Imprimir"]</BSLabel>
                    </BSRow>
                    <BSButton IsOutlined Color="BSColor.Success" Size="Size.ExtraSmall" @onclick="PrintDocument"> <span
                            class="oi oi-print"></span></BSButton>
                </BSCol>
            }
        </BSRow>
    }

</BSContainer>

<p>
</p>

@if (PizarraData.reudiatablas.Count() > 0 && dataIsLoaded == 2)
{
    <BSContainer>

        <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
            <BSTHead Class="cabecera">
                <BSTR>

                    @*<BSTD>Id</BSTD>*@

                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Area"]</BSTD>
                    <BSTD>Ksf</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["NombreDelEquipo"]</BSTD>
                    <BSTD ColSpan="4">@DiccionarioTraduccionesService.Traducciones["Discrepancia"]</BSTD>
                    @* <BSTD>Código</BSTD> *@
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["PlanDeAccion"]</BSTD>
                    @* <BSTD>Tiempo</BSTD> *@
                    <BSTD ColSpan="1">@DiccionarioTraduccionesService.Traducciones["Responsable"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["DetallesDeCalidad"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["OrgDelProducto"]</BSTD>
                    <BSTD>Status</BSTD>
                    @* <BSTD>ODT</BSTD> *@
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDeReunion"]</BSTD>@*Fecha de listo el trabajo*@
                    @if (Rol == "Admin" | Rol == "AdminChempro" | Rol == "SuperUser" | Rol == "SemiAdmin"  | Rol == "PrimeUser" )
                    {
                        <BSTD></BSTD>

                    }

                </BSTR> 
            </BSTHead>
            <BSTBody>
                @foreach (var d in PizarraData.reudiatablas)
                {
                    @if (d.Rdstatus != "Rechazada" && d.Rdstatus != "Listo" & d.RdfecTra <= DateTime.Now | (d.Rdstatus != "Listo" & (d.Rdodt == "" | d.Rdodt is null)))
                    //@if (d.Rdstatus != "Listo")
                    {
                        @if (Codigo == d.RdcodDis | Codigo == "Todo")
                        @if (Origencalidad == "Todo" || Origencalidad == d.OrigenCal)
                        {

                            <BSTR>

                                @*<BSTD>@d.IdReuDia</BSTD>*@
                                @* <BSTD>@d.Rddiv</BSTD>*@
                                <BSTD>@d.Rdarea</BSTD>
                                <BSTD>
                                @{
                                    var texto = idPais == 5 
                                        ? KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfEnglish 
                                        : KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfNombre;
                                }
                                @texto
                                </BSTD>
                                <BSTD>@d.RdcodEq</BSTD>
                                <BSTD>
                                @{
                                    var texto = string.IsNullOrWhiteSpace(d.EnombreEam)
                                        ? (idPais == 5 ? "EQUIPMENT NOT FOUND" : "EQUIPO NO ENCONTRADO")
                                        : d.EnombreEam;
                                }
                                @texto
                                </BSTD>
                                <BSTD ColSpan="4">@d.Rddisc.ToUpper()</BSTD>
                                @* <BSTD>@d.RdcodDis</BSTD> *@
                                @if (@d.RdplanAcc is not null)
                                {
                                    <BSTD Class="textotabla listo">@d.RdplanAcc</BSTD>
                                }
                                else
                                {
                                    <BSTD Class="textotabla ">@d.RdplanAcc</BSTD>
                                }
                                @* <BSTD>@d.Rdtiempo</BSTD> *@
                                @{
                                    var responsable = RespoReuData.resporeus.FirstOrDefault(x => x.IdResReu == d.IdResReu);
                                    var nombreResponsable = idPais == 5 
                                        ? responsable?.Rrenglish 
                                        : responsable?.Rrnombre ?? string.Empty;
                                        }
                                <BSTD class="@(nombreResponsable == "Por Definir" ? "Definir" : "")">@nombreResponsable</BSTD>
                                <BSTD>
                                    @{
                                        var causa = CausaCalidadData.causaCals.FirstOrDefault(x => x.IdCausaCal == d.IdCausaCal);
                                        var texto = idPais == 5 ? causa?.Ccenglish : causa?.Ccnombre;
                                    }
                                    @texto
                                </BSTD>
                                <BSTD>@d.OrigenCal.ToUpperInvariant()</BSTD>


                                @{
                                    var estadoTraducido = d.Rdstatus == "Cerrado"
                                        ? (idPais == 5 ? "Closed" : "Cerrado")
                                        : (idPais == 5 ? "Pending" : "Pendiente");

                                    var claseEstado = d.Rdstatus == "Cerrado" ? "Cerrado" : "pendiente";
                                }

                                <BSTD Class="@claseEstado">@estadoTraducido</BSTD>
                                @* <BSTD>@d.Rdodt</BSTD> *@
                                <BSTD>@d.RdfecTra.ToString("dd/MM/yyyy") </BSTD>
                                @if (Rol == "Admin" | Rol == "AdminChempro" | Rol == "SuperUser" | Rol == "SemiAdmin")
                                {
                                    <BSTD>
                                        <button class="btn btn-success" @onclick="(() => Editar(d.IdReuDia))"><i
                                                class="oi oi-pencil"></i></button>
                                    </BSTD>
                                }

                            </BSTR>
                        }
                    }
                }


            </BSTBody>

        </BSTable>
    </BSContainer>
}
else if (dataIsLoaded == 1 && PizarraData.reudiatablas.Count() == 0)
{
    <div class="loader"></div>
}
else if (dataIsLoaded == 2 && PizarraData.reudiatablas.Count() == 0)
{
<div style="text-align: center; padding: 20px; font-size: 18px; color: rgb(102, 101, 101);">
    <p>@DiccionarioTraduccionesService.Traducciones["NoHayDatos"]</p>
</div>
}

@code {

    [Parameter]
    public string? accion { get; set; }//centro
    [Parameter]
    public string? division { get; set; }//division
    [Parameter]
    public string? linea { get; set; }//linea
    [Parameter]
    public string? f1 { get; set; }
    [Parameter]
    public string? f2 { get; set; }
    [Parameter]
    public string? tipo { get; set; }
    [Parameter]
    public string? est { get; set; }


    int dataIsLoaded = 0, filtrocod = 0;
    string ayer = DateTime.Now.AddDays(-1).ToString("yyyyMMdd");
    string error;
    
    private string? Origencalidad { get; set; } ="Todo";
    private int IdCentro { get; set; } = 0; //id del Centro
    private int IdDiv { get; set; } = 0; //id de la division
    private int CentroComedor;//Variable para verificar si es el comedor venezuela;
    private NotifiRadzen Notificar = new NotifiRadzen();//Logic para crear las noyificaciones radzen


    //private string Div { get; set; } //Centro
    //private string Division { get; set; } //División


    private string Codigo { get; set; } = "Todo"; //Codigo
    private string Rol { get; set; } = ""; //Rol del usuario

    private string mensaje {get; set; } = "";

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private int idPais { get; set; }
    private bool traduccionesCargadas = false;



    private List<Claim> claims { get; set; }

    private async Task CreateData()

    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);
        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }
    }

    private async Task SetCentroInicialAsync()
    {
        // Confirmar que hay centros cargados
        if (MaestraData?.centro == null || !MaestraData.centro.Any())
            return;

        // Tomar IdCentro del claim (evita usar índices frágiles como claims[11])
        var idCentroClaimStr = claims?.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value;
        int.TryParse(idCentroClaimStr, out var idCentroClaim);

        // Usa el claim si coincide; si no, el primero de la lista
        if (idCentroClaim > 0 && MaestraData.centro.Any(x => x.IdCentro == idCentroClaim))
        {
            IdCentro = idCentroClaim;
        }
        else
        {
            IdCentro = MaestraData.centro.First().IdCentro;
        }

        // Disparar lógica dependiente manualmente
        await BuscarDivision(new ChangeEventArgs { Value = IdCentro });

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await CreateData();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;
        Rol = claims?.FirstOrDefault(c => c.Type.Contains("role"))?.Value;
        var idEmpresa = claims?.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value;
        var idCentroClaim = claims?.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value;

        // Roles que ven "All + Empresa"
        bool rolMantienePlaceholder = Rol is "Admin" or "SuperAdmin" or "PrimeUser" or "MttoAdmin" or "SeguridadAdmin" or "CalidadAdmin" or "Auditores";

        if (rolMantienePlaceholder && !string.IsNullOrWhiteSpace(idEmpresa))
        {
            await MaestraData.GetCentrosxEmpresa("All" + idEmpresa);
        }
        else
        {
            await MaestraData.GetCentrosxEmpresa(idCentroClaim);
        }

        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        await CausaCalidadData.GetCausasCalidad();
         // --- AQUÍ va la decisión y el llamado ---
        if (rolMantienePlaceholder)
        {
            // Estos roles: mostrar "Seleccione", no auto-seleccionar
            IdCentro = 0;
            // No llamamos BuscarDivision aún (no hay centro escogido)
        }
        else
        {
            // Otros roles: auto-selección
            await SetCentroInicialAsync();
        }
    }

    protected async Task BuscarDivision(ChangeEventArgs e)
    {
            IdCentro = int.Parse(e.Value.ToString());
            IdDiv = 0;
            try{
                if(IdCentro != 0){
                    MaestraData.divisions = await MaestraData.ObtenerDivisionDelCentro(IdCentro);
                }
            }catch(Exception ex){
                            NotificationService.Notify(Notificar.Notificacion("error", "Error", DiccionarioTraduccionesService.Traducciones["SCentro"]));
            }
    }


protected async Task Get()
{
    if (IdCentro != 0 && IdDiv != 0)
    {
        error = null;

        if (dataIsLoaded != 1)
        {
            dataIsLoaded = 1;

            // Definir el rango de fechas para el día de ayer y hoy
            DateTime fechaInicio = DateTime.Today.AddDays(-1); // Ayer
            DateTime fechaFin = DateTime.Today.AddDays(1).AddTicks(-1); // Fin del día de hoy

            // Obtener los datos
            PizarraData.reudiatablas = await PizarraData.GetPendientes(
                IdCentro.ToString(),
                IdDiv.ToString(),
                fechaInicio,
                fechaFin,
                "1",
                "Reunion"
            ) ?? new List<ReunionDTO>();

            // Filtrar los datos para asegurar que solo queden reuniones del día de ayer y hoy
            if (PizarraData.reudiatablas != null)
            {
                PizarraData.reudiatablas = PizarraData.reudiatablas
                    .Where(r => r != null && (r.RdfecReu.Date == DateTime.Today || r.RdfecReu.Date == DateTime.Today.AddDays(-1))) // Filtrar por la fecha de reunión
                    .ToList();
            }

            dataIsLoaded = 2;
        }
    }
    else
    {
        NotificationService.Notify(Notificar.Notificacion("advertencia", DiccionarioTraduccionesService.Traducciones["Atencion"], DiccionarioTraduccionesService.Traducciones["SVLista"]));
    }
}

void Editar(int id)
{
    var ruta = idPais == 5 ? "en" : "es";
    var fechaHoy = DateTime.Today.ToString("dd-MM-yyyy");
    var url = $"{ruta}/EditDisc/{id}/1/Re/{fechaHoy}/{fechaHoy}/Reunion";
    NavigationManager.NavigateTo(url);

    // Usar la fecha de hoy formateada en el formato "dd-MM-yyyy"
    //string fechaHoy = DateTime.Today.ToString("dd-MM-yyyy");
    //NavigationManager.NavigateTo($"EditDisc/{id}/1/Re/{fechaHoy}/{fechaHoy}/Reunion");
}



protected override async Task OnParametersSetAsync()
{
    if (accion != null)
    {
        dataIsLoaded = 1;

        IdCentro = int.Parse(accion);
        IdDiv = int.Parse(division);

        // Definir el rango de fechas para el día actual
        DateTime fechaHoyInicio = DateTime.Today;
        DateTime fechaHoyFin = DateTime.Today.AddDays(1).AddTicks(-1);

        // Obtener los datos
        
        try
        {
            PizarraData.reudiatablas = await PizarraData.GetPendientes(
            accion,
            division,
            fechaHoyInicio,
            fechaHoyFin,
            tipo,
            "Reunion") ?? new List<ReunionDTO>();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(Notificar.Notificacion("error", "Error", DiccionarioTraduccionesService.Traducciones["Error"]));
        }
        // Filtrar los datos para mostrar solo las reuniones del día actual
        if (PizarraData.reudiatablas != null)
        {
            PizarraData.reudiatablas = PizarraData.reudiatablas
                .Where(r => r != null && r.RdfecReu.Date == DateTime.Today) // Filtrar por fecha de reunión
                .ToList();
        }

        dataIsLoaded = 2;
    }
}

        public async Task PrintDocument()
    {
        string idiomaRuta = idPais == 5 ? "en" : "es";
        string nombrePagina = idPais == 5 ? "TableMeeting" : "TablaReunion";
        string url = $"{idiomaRuta}/{nombrePagina}/{IdCentro}/{IdDiv}/{DateTime.Now.AddDays(-1):dd-MM-yyyy}/{DateTime.Now:dd-MM-yyyy}/1";
        
        await IJS.InvokeVoidAsync("open", url, "_blank");
    }



}