@inject AuthenticationStateProvider AuthenticationStateProvider
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <small class="text-muted"> Powered By  </small><img src="./images/LogoNeo.png" alt="PAVECA" width="60px" />
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">

        <AuthorizeView Roles="Admin,AdminChempro, SuperUser, SemiAdmin">

            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="oi oi-home" aria-hidden="true"></span> <strong>Home</strong>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@discrepanciaHref">
                        <span class="oi oi-warning" aria-hidden="true"></span> <strong>@labelDiscrepancias</strong>
                    </NavLink>
                </div>
                
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@pendientesHref">
                        <span class="oi oi-tags" aria-hidden="true"></span> <strong>@labelAsuntos</strong>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@asistenciaHref">
                        <span class="oi oi-list" aria-hidden="true"></span> <strong>@labelAsistencia</strong>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@porcentajeAsistenciaHref">
                        <span class="oi oi-graph" aria-hidden="true"></span> <strong>@labelPorcentajeAsistencia</strong>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@reunionHref">
                        <span class="oi oi-people" aria-hidden="true"></span> <strong>@labelPizarra</strong>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@historicosHref">
                        <span class="oi oi-spreadsheet" aria-hidden="true"></span> <strong>@labelHistoricos</strong>
                    </NavLink>
                </div>
                @* <div class="nav-item px-3">
                    <NavLink class="nav-link" href="calendario">
                        <span class=" oi oi-calendar" aria-hidden="true"></span> Calendario
                    </NavLink>
                </div> *@

            </Authorized>


            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="oi oi-home" aria-hidden="true"></span> <strong>Home</strong>
                    </NavLink>
                </div>


                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@pendientesHref">
                        <span class="oi oi-tags" aria-hidden="true"></span> <strong>@labelAsuntos</strong>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@reunionHref">
                        <span class="oi oi-people" aria-hidden="true"></span> <strong>@labelPizarra</strong>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@historicosHref">
                        <span class="oi oi-spreadsheet" aria-hidden="true"></span> <strong>@labelHistoricos</strong>
                    </NavLink>
                </div>
                @* <div class="nav-item px-3">
                    <NavLink class="nav-link" href="calendario">
                        <span class=" oi oi-calendar" aria-hidden="true"></span> Calendario
                    </NavLink>
                </div> *@

            </NotAuthorized>

        </AuthorizeView>
        <AuthorizeView Roles="Admin,AdminChempro, SuperUser,SemiAdmin,MttoAdmin">
            <Authorized>

                @* <div class="nav-item px-3">
                    <NavLink class="nav-link" href="stats_asistencia">
                        <span class="oi oi-graph" aria-hidden="true"></span> %Asistencias
                    </NavLink>
                </div> *@
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,AdminChempro,SuperAdmin">
            <Authorized>
                @* <div class="nav-item px-3">
                    <NavLink class="nav-link" href="addequipo">
                        <span class="oi oi-wrench" aria-hidden="true"></span> Equipos
                    </NavLink>
                </div> *@
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private string labelDiscrepancias = "Discrepancias";
    private string labelAsuntos = "Asuntos";
    private string labelAsistencia = "Asistencia";
    private string labelPorcentajeAsistencia= "Porcentaje Asistencia";
    private string labelPizarra = "Pizarra";
    private string labelHistoricos = "Históricos";
    private string discrepanciaHref = "/es/discrepancia";
    private string pendientesHref = "/es/pendientes";
    private string asistenciaHref = "/es/asistencia";
    private string reunionHref = "/es/reunion";
    private string historicosHref = "/es/historicos";
    private string porcentajeAsistenciaHref = "/es/porcentajeasistencia";
    private const int TrinidadYTobago = 5;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            int.TryParse(user.FindFirst(c => c.Type == "IdPais")?.Value, out int idPais);

            if (idPais == TrinidadYTobago)
            {
                labelDiscrepancias = "Discrepancy";
                labelAsuntos = "Issues";
                labelAsistencia = "Attendance";
                labelPorcentajeAsistencia = "Attendance Percentage ";
                labelPizarra = "Whiteboard";
                labelHistoricos = "Historical";
                discrepanciaHref = "/en/discrepancy";
                pendientesHref = "/en/remaining";
                asistenciaHref = "/en/attendance";
                porcentajeAsistenciaHref = "/en/attendancepercentage";
                reunionHref = "/en/meeting";
                historicosHref = "/en/historical";

            }
        }
    }


    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
